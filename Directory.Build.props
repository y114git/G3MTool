<Project>
  <PropertyGroup>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- needed for IDE0005 (unused usings) to run in the build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- One place for the G3MLib package version of the CLI and the GUI. -->
    <G3MLibVersion Condition="'$(G3MLibVersion)' == ''">1.1.3</G3MLibVersion>
  </PropertyGroup>
</Project>
