<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>G3MToolCLI</RootNamespace>
    <AssemblyName>G3MTool</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Publish settings -->
    <Version>1.0.2</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <CopyDocumentationFilesToPublishDirectory>false</CopyDocumentationFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLI parsing -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />

    <!-- Roslyn scripting -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />

    <!-- System.Text.Json is included in .NET 10 by default -->

    <!-- UndertaleModLib - embedded -->
    <ProjectReference Include="Lib\UndertaleModLib\UndertaleModLib.csproj" />
  </ItemGroup>

  <!-- Embed xdelta binaries - platform-specific -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <EmbeddedResource Include="Assets\bin\win\**\*" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <EmbeddedResource Include="Assets\bin\linux\**\*" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <EmbeddedResource Include="Assets\bin\mac\**\*" />
  </ItemGroup>

  <!-- Embed scripts -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\scripts\**\*.csx" />
  </ItemGroup>

  <!-- Compile only G3MToolCLI source files, not Lib -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="Lib\**\*.cs;obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

</Project>
